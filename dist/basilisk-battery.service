[Unit]
Description=Razer Basilisk V3 X HyperSpeed battery level for UPower
Documentation=https://github.com/arkady-emelyanov/basilisk-battery

[Service]
ExecStart=/usr/local/bin/basilisk-battery run
Restart=on-failure
RestartSec=5

# Needs only /dev/uhid (to create the virtual battery) and the receiver's hidraw node.
DevicePolicy=closed
DeviceAllow=/dev/uhid rw
DeviceAllow=char-hidraw rw
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
